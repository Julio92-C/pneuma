/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC_TABLES' {
        publishDir = [ path: { "${params.outdir}/multiqc/custom_tables" }, mode: params.publish_dir_mode, pattern: '*_mqc.tsv' ]
    }

    withName: 'NANOQ' {
        ext.args   = { "-vv --min-len ${params.nanoq_min_length} --min-qual ${params.nanoq_min_qscore}" }  // -vv: text report that MultiQC's nanoq module parses
        ext.prefix = { "${meta.id}.nanoq" }
        publishDir = [ path: { "${params.outdir}/preprocess/nanoq" }, mode: params.publish_dir_mode, pattern: '*.stats' ]
    }
    // Intermediate: pooled reads of multi-run samples, adapter-trimmed reads, unpacked database
    withName: 'CAT_FASTQ|UNTAR' {
        publishDir = [ enabled: false ]
    }
    withName: 'PORECHOP_ABI' {
        publishDir = [ path: { "${params.outdir}/preprocess/porechop_abi" }, mode: params.publish_dir_mode, pattern: '*.log' ]
    }
    withName: 'HOSTILE_CLEAN' {
        publishDir = [ path: { "${params.outdir}/preprocess/clean_reads" }, mode: params.publish_dir_mode ]
    }
    withName: 'NANOPLOT' {
        ext.args   = { "-p ${meta.id}." }  // sample-named NanoStats.txt: MultiQC needs unique file names
        publishDir = [ path: { "${params.outdir}/preprocess/nanoplot/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SEQKIT_STATS' {
        ext.args   = '-T -a'
        publishDir = [ path: { "${params.outdir}/preprocess/seqkit" }, mode: params.publish_dir_mode ]
    }

    withName: 'KRAKEN2_KRAKEN2' {
        ext.args   = { "--confidence ${params.kraken2_confidence}" }
        publishDir = [ path: { "${params.outdir}/taxonomy/kraken2" }, mode: params.publish_dir_mode,
                       pattern: '*.{report.txt,classifiedreads.txt}' ]
    }
    withName: 'BRACKEN_BRACKEN' {
        ext.args      = { "-l ${params.bracken_level} -t ${params.bracken_threshold} -r ${params.bracken_read_length}" }
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'retry' }  // no taxa above threshold -> sample has no Bracken estimate
        publishDir    = [ path: { "${params.outdir}/taxonomy/bracken" }, mode: params.publish_dir_mode ]
    }
    withName: 'ARRANGE_REPORTS|COMBINE_KRAKEN|COMBINE_BRACKEN' {
        publishDir = [ path: { "${params.outdir}/taxonomy" }, mode: params.publish_dir_mode ]
    }
    // Intermediate Krona input; the Krona HTML below is the deliverable
    withName: 'KRAKENTOOLS_KREPORT2KRONA' {
        publishDir = [ enabled: false ]
    }
    withName: 'KRONA_KTIMPORTTEXT' {
        publishDir = [ path: { "${params.outdir}/taxonomy/krona" }, mode: params.publish_dir_mode ]
    }


    withName: 'RECENTRIFUGE' {
        ext.args   = '-s NORMA -y 25 -x 9606 -d'
        publishDir = [ path: { "${params.outdir}/contamination" }, mode: params.publish_dir_mode ]
    }

    withName: 'ABRICATE_READS|ABRICATE_MERGE' {
        publishDir = [ path: { "${params.outdir}/functional" }, mode: params.publish_dir_mode ]
    }
    withName: 'TAG_READS' {
        publishDir = [ enabled: false ]
    }

    // --build_databases: everything is copied into --db_outdir (the large downloads are not symlinked)
    withName: 'PREPARE_KRAKEN2_DB|PREPARE_TAXDUMP|PREPARE_HOSTILE_INDEX|PREPARE_ABRICATE_DB|PREPARE_MOBSUITE_DB|PREPARE_MEDAKA_MODEL|PREPARE_MLST_SCHEMES|PREPARE_PANEL_REFERENCES' {
        publishDir = [
            path: { params.db_outdir },
            mode: 'copy',
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.row.tsv')) ? null : filename }
        ]
    }
    withName: 'CHECKM2_DATABASEDOWNLOAD' {
        publishDir = [ path: { "${params.db_outdir}/checkm2" }, mode: 'copy' ]
    }
    withName: 'BAKTA_BAKTADBDOWNLOAD' {
        ext.args   = { "--type ${params.bakta_db_type}" }
        publishDir = [ path: { "${params.db_outdir}/bakta" }, mode: 'copy' ]
    }
    withName: 'AMRFINDERPLUS_UPDATE' {
        publishDir = [ path: { "${params.db_outdir}/amrfinderplus" }, mode: 'copy' ]
    }
    withName: 'DATABASE_ROW' {
        publishDir = [ enabled: false ]
    }
    withName: 'DATABASE_MANIFEST' {
        publishDir = [
            path: { params.db_outdir },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MERIDIAN_RUN' {
        publishDir = [ path: { "${params.outdir}/meridian/${task.tag.replaceAll(/[^A-Za-z0-9_.-]/, '_')}" }, mode: params.publish_dir_mode ]
    }
    withName: 'RCF_FOR_MERIDIAN' {
        publishDir = [ path: { "${params.outdir}/meridian/inputs" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.endsWith('.csv') ? fn : null } ]
    }
    withName: 'MERIDIAN_CONFIG' {
        publishDir = [ path: { "${params.outdir}/meridian/${task.tag.replaceAll(/[^A-Za-z0-9_.-]/, '_')}" }, mode: params.publish_dir_mode ]
    }

    withName: 'RESOLVE_PANEL' {
        publishDir = [ path: { "${params.outdir}/pathogens/panel" }, mode: params.publish_dir_mode ]
    }

    withName: 'PATHOGEN_CANDIDATES' {
        publishDir = [ path: { "${params.outdir}/pathogens" }, mode: params.publish_dir_mode ]
    }

    withName: 'KRAKENTOOLS_EXTRACTKRAKENREADS' {
        ext.args   = '--include-children --fastq-output'
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }
    withName: 'MINIMAP2_GATE' {
        ext.args   = '-x map-ont --secondary=no'
        ext.prefix = { "${meta.id}.gate" }
        publishDir = [ enabled: false ]
    }
    withName: 'SAMTOOLS_COVERAGE' {
        ext.prefix = { "${meta.id}.coverage" }
        publishDir = [ path: { "${params.outdir}/pathogens/gate" }, mode: params.publish_dir_mode ]
    }
    withName: 'COVERAGE_GATE' {
        publishDir = [ path: { "${params.outdir}/pathogens/gate" }, mode: params.publish_dir_mode ]
    }

    // Spec 7: Flye/Medaka failures become ASSEMBLY_FAILED (absent assembly), never a failed run.
    // Memory-type exits are retried with more memory first; ONLY these two processes ignore failures.
    withName: 'FLYE|MEDAKA_CONSENSUS' {
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] && task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'FLYE' {
        ext.args   = { params.flye_meta ? '--meta' : '' }
        publishDir = [ path: { "${params.outdir}/pathogens/assemblies/flye" }, mode: params.publish_dir_mode, pattern: '*.{log,txt}' ]
    }
    withName: 'GUNZIP_FLYE' {
        publishDir = [ enabled: false ]
    }
    withName: 'MEDAKA_CONSENSUS' {
        publishDir = [ path: { "${params.outdir}/pathogens/assemblies" }, mode: params.publish_dir_mode ]
    }
    withName: 'CHECKM2_PREDICT|BAKTA_BAKTA' {
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    withName: 'CHECKM2_PREDICT' {
        // files are passed as a list (not a folder), so CheckM2's -x extension filter does not apply
        publishDir = [ path: { "${params.outdir}/pathogens/qc/checkm2" }, mode: params.publish_dir_mode, pattern: '*_checkm2_report.tsv' ]
    }
    withName: 'QUAST' {
        publishDir = [ path: { "${params.outdir}/pathogens/qc/quast" }, mode: params.publish_dir_mode ]
    }

    // Species confirmation, typing and annotation (PATHOGEN_TYPING). The CHECKM2_PREDICT|BAKTA_BAKTA
    // retry closure above also covers BAKTA_BAKTA.
    withName: 'SKANI_DIST' {
        ext.prefix = { "${meta.id}.skani" }
        publishDir = [ path: { "${params.outdir}/pathogens/species" }, mode: params.publish_dir_mode ]
    }
    withName: 'SPECIES_CONFIRM' {
        publishDir = [ path: { "${params.outdir}/pathogens/species" }, mode: params.publish_dir_mode ]
    }
    withName: 'MLST' {
        publishDir = [ path: { "${params.outdir}/pathogens/typing/mlst" }, mode: params.publish_dir_mode ]
    }
    withName: 'AMRFINDERPLUS_RUN' {
        publishDir = [ path: { "${params.outdir}/pathogens/typing/amrfinderplus" }, mode: params.publish_dir_mode ]
    }
    withName: 'ABRICATE_VFDB' {
        ext.args   = { "--db vfdb --minid ${params.abricate_minid} --mincov ${params.abricate_mincov}" }
        ext.prefix = { "${meta.id}.vfdb" }
        publishDir = [ path: { "${params.outdir}/pathogens/typing/abricate" }, mode: params.publish_dir_mode, pattern: '*.txt' ]
    }
    withName: 'ABRICATE_PLASMIDFINDER' {
        ext.args   = { "--db plasmidfinder --minid ${params.abricate_minid} --mincov ${params.abricate_mincov}" }
        ext.prefix = { "${meta.id}.plasmidfinder" }
        publishDir = [ path: { "${params.outdir}/pathogens/typing/abricate" }, mode: params.publish_dir_mode, pattern: '*.txt' ]
    }
    withName: 'BAKTA_BAKTA' {
        ext.args   = '--skip-plot'
        publishDir = [ path: { "${params.outdir}/pathogens/annotation/bakta/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'MOBSUITE_RECON' {
        publishDir = [ path: { "${params.outdir}/pathogens/typing/mobsuite" }, mode: params.publish_dir_mode ]
    }
    withName: 'MINIMAP2_MIXED' {
        ext.args   = '-x map-ont --secondary=no'
        ext.prefix = { "${meta.id}.pooled" }
        publishDir = [ enabled: false ]
    }
    withName: 'SAMTOOLS_MPILEUP' {
        ext.args   = '-B -Q 10 -q 20 -d 10000'
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }
    withName: 'MIXED_STRAIN_CHECK' {
        publishDir = [ path: { "${params.outdir}/pathogens/mixed_strain" }, mode: params.publish_dir_mode ]
    }
    withName: 'BUILD_PATHOGEN_REPORT' {
        publishDir = [ path: { "${params.outdir}/pathogens/report" }, mode: params.publish_dir_mode ]
    }
}
