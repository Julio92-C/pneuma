/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC_TABLES' {
        publishDir = [ path: { "${params.outdir}/multiqc/custom_tables" }, mode: params.publish_dir_mode, pattern: '*_mqc.tsv' ]
    }

    withName: 'NANOQ' {
        ext.args   = { "-vv --min-len ${params.nanoq_min_length} --min-qual ${params.nanoq_min_qscore}" }  // -vv: text report that MultiQC's nanoq module parses
        ext.prefix = { "${meta.id}.nanoq" }
        publishDir = [ path: { "${params.outdir}/preprocess/nanoq" }, mode: params.publish_dir_mode, pattern: '*.stats' ]
    }
    // Intermediate: pooled reads of multi-run samples, adapter-trimmed reads, unpacked database
    withName: 'CAT_FASTQ|UNTAR' {
        publishDir = [ enabled: false ]
    }
    withName: 'PORECHOP_ABI' {
        publishDir = [ path: { "${params.outdir}/preprocess/porechop_abi" }, mode: params.publish_dir_mode, pattern: '*.log' ]
    }
    withName: 'HOSTILE_CLEAN' {
        publishDir = [ path: { "${params.outdir}/preprocess/clean_reads" }, mode: params.publish_dir_mode ]
    }
    withName: 'NANOPLOT' {
        ext.args   = { "-p ${meta.id}." }  // sample-named NanoStats.txt: MultiQC needs unique file names
        publishDir = [ path: { "${params.outdir}/preprocess/nanoplot/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SEQKIT_STATS' {
        ext.args   = '-T -a'
        publishDir = [ path: { "${params.outdir}/preprocess/seqkit" }, mode: params.publish_dir_mode ]
    }

    withName: 'KRAKEN2_KRAKEN2' {
        ext.args   = { "--confidence ${params.kraken2_confidence}" }
        publishDir = [ path: { "${params.outdir}/taxonomy/kraken2" }, mode: params.publish_dir_mode,
                       pattern: '*.{report.txt,classifiedreads.txt}' ]
    }
    withName: 'BRACKEN_BRACKEN' {
        ext.args      = { "-l ${params.bracken_level} -t ${params.bracken_threshold} -r ${params.bracken_read_length}" }
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'retry' }  // no taxa above threshold -> sample has no Bracken estimate
        publishDir    = [ path: { "${params.outdir}/taxonomy/bracken" }, mode: params.publish_dir_mode ]
    }
    withName: 'ARRANGE_REPORTS|COMBINE_KRAKEN|COMBINE_BRACKEN' {
        publishDir = [ path: { "${params.outdir}/taxonomy" }, mode: params.publish_dir_mode ]
    }
    // Intermediate Krona input; the Krona HTML below is the deliverable
    withName: 'KRAKENTOOLS_KREPORT2KRONA' {
        publishDir = [ enabled: false ]
    }
    withName: 'KRONA_KTIMPORTTEXT' {
        publishDir = [ path: { "${params.outdir}/taxonomy/krona" }, mode: params.publish_dir_mode ]
    }


    withName: 'RECENTRIFUGE' {
        ext.args   = '-s NORMA -y 25 -x 9606 -d'
        publishDir = [ path: { "${params.outdir}/contamination" }, mode: params.publish_dir_mode ]
    }

    withName: 'ABRICATE_READS|ABRICATE_MERGE' {
        publishDir = [ path: { "${params.outdir}/functional" }, mode: params.publish_dir_mode ]
    }
    withName: 'TAG_READS' {
        publishDir = [ enabled: false ]
    }

    // --build_databases: everything is copied into --db_outdir (the large downloads are not symlinked)
    withName: 'PREPARE_KRAKEN2_DB|PREPARE_TAXDUMP|PREPARE_HOSTILE_INDEX|PREPARE_ABRICATE_DB' {
        publishDir = [
            path: { params.db_outdir },
            mode: 'copy',
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.row.tsv')) ? null : filename }
        ]
    }
    withName: 'DATABASE_MANIFEST' {
        publishDir = [
            path: { params.db_outdir },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MERIDIAN_RUN' {
        publishDir = [ path: { "${params.outdir}/meridian/${task.tag.replaceAll(/[^A-Za-z0-9_.-]/, '_')}" }, mode: params.publish_dir_mode ]
    }
    withName: 'RCF_FOR_MERIDIAN' {
        publishDir = [ path: { "${params.outdir}/meridian/inputs" }, mode: params.publish_dir_mode, saveAs: { fn -> fn.endsWith('.csv') ? fn : null } ]
    }
    withName: 'MERIDIAN_CONFIG' {
        publishDir = [ path: { "${params.outdir}/meridian/${task.tag.replaceAll(/[^A-Za-z0-9_.-]/, '_')}" }, mode: params.publish_dir_mode ]
    }

    withName: 'RESOLVE_PANEL' {
        publishDir = [ path: { "${params.outdir}/pathogens/panel" }, mode: params.publish_dir_mode ]
    }
}
