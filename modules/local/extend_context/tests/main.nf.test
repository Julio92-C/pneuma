nextflow_process {
    name "Test EXTEND_CONTEXT"
    script "../main.nf"
    process "EXTEND_CONTEXT"

    test("read hits take the contig call through the PAF") {
        when {
            process {
                """
                def d = "${projectDir}/tests/data/context/assembly"
                input[0] = [ 'card', file("\$d/loci_reads_card.tsv", checkIfExists: true), file("\$d/loci_contigs_card.tsv", checkIfExists: true) ]
                input[1] = [ file("\$d/S1.paf", checkIfExists: true) ]
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.context[0][1]).readLines()
            def head = rows[0].split('\t') as List
            def r1 = rows.drop(1).collect { it.split('\t', -1) }.find { it[head.indexOf('seq')] == 'S1__r1' }
            assert r1[head.indexOf('final_context')] == 'plasmid'
            assert r1[head.indexOf('context_source')] == 'contig'
        }
    }

    test("no alignments") {
        when {
            process {
                """
                def d = "${projectDir}/tests/data/context/assembly"
                input[0] = [ 'card', file("\$d/loci_reads_card.tsv", checkIfExists: true), file("\$d/loci_contigs_card.tsv", checkIfExists: true) ]
                input[1] = []
                """
            }
        }
        then {
            assert process.success
            assert path(process.out.context[0][1]).readLines().drop(1).every { it.contains('no_contig_match') }
        }
    }
}
