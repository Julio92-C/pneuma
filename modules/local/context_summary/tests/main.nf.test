nextflow_process {
    name "Test CONTEXT_SUMMARY"
    script "../main.nf"
    process "CONTEXT_SUMMARY"

    test("hit_context.tsv with taxon fields, and the summaries by group") {
        when {
            params { meridian_group = 'sample_type' }
            process {
                """
                def d = "${projectDir}/tests/data/context/summary"
                input[0] = [ file("\$d/hit_context_card.tsv", checkIfExists: true) ]
                input[1] = file("\$d/taxa.tsv", checkIfExists: true)
                input[2] = file("${projectDir}/tests/data/pathogen_fixture/taxdump", checkIfExists: true, type: 'dir')
                input[3] = file("\$d/metadata.csv", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.hit_context[0]).readLines()
            def head = rows[0].split('\t') as List
            assert head.containsAll(['element', 'final_context', 'kraken_taxid', 'species', 'taxon_level', 'weak_vote'])
            def r1 = rows[1].split('\t', -1)
            assert r1[head.indexOf('species')] == 'Escherichia coli'
            assert r1[head.indexOf('weak_vote')] == 'yes'                         // one read on the contig
            assert rows[2].split('\t', -1)[head.indexOf('weak_vote')] == 'NA'     // not on a contig
            def names = process.out.summary[0].collect { p -> p.toString().tokenize('/').last() }.sort()
            assert names == ['arg_context_by_class.tsv', 'arg_context_by_group.tsv', 'arg_context_by_sample.tsv',
                             'gene_context.tsv', 'taxon_resolution.tsv']
        }
    }

    test("layer 1 only: read loci become hit_context rows without contig columns") {
        when {
            process {
                """
                input[0] = [ file("${projectDir}/tests/data/context/assembly/loci_reads_card.tsv", checkIfExists: true) ]
                input[1] = []
                input[2] = file("${projectDir}/tests/data/pathogen_fixture/taxdump", checkIfExists: true, type: 'dir')
                input[3] = []
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.hit_context[0]).readLines()
            def head = rows[0].split('\t') as List
            assert rows.size() == 4
            assert rows.drop(1).every { it.split('\t', -1)[head.indexOf('contig_context')] == 'no_contig_match' }
            assert process.out.summary[0].size() == 4                             // no metadata: no group table
        }
    }
}
