// Test-only: MERIDIAN_RUN does no real work (python image, ext.test_noop) but succeeds, so a
// pipeline-level test can count one successful MERIDIAN_RUN task per comparison.
process {
    withName: 'MERIDIAN_RUN' {
        container = 'quay.io/biocontainers/python:3.9--1'
        ext.test_noop = true
        ext.test_stage_error = 'site'   // this comparison reports a caught MERIDIAN stage failure
    }
}
