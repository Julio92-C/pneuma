// Default-suite real-tool tests on tests/data/pathogen_mini: read-only + offline containers, and the
// tools that need multi-GB databases switched off (they get real tests in tests/pathogen/).
includeConfig 'pathogen_readonly.config'
process {
    withName: 'CHECKM2_PREDICT|BAKTA_BAKTA|AMRFINDERPLUS_RUN' {
        ext.when = false
    }
}
