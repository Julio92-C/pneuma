// Read-only root filesystem + tmpfs /tmp + no network: how Singularity runs the images on an HPC cluster
// compute nodes. A tool that writes inside its image or downloads at run time fails here, not on the HPC.
process {
    withName: 'MINIMAP2_GATE|SAMTOOLS_COVERAGE|FLYE|GUNZIP_FLYE|MEDAKA_CONSENSUS|CHECKM2_PREDICT|QUAST|SKANI_DIST|MLST|AMRFINDERPLUS_RUN|ABRICATE_VFDB|ABRICATE_PLASMIDFINDER|BAKTA_BAKTA|MOBSUITE_RECON|MINIMAP2_MIXED|SAMTOOLS_MPILEUP|KRAKENTOOLS_EXTRACTKRAKENREADS' {
        containerOptions = '--read-only --tmpfs /tmp --network none'
    }
}
