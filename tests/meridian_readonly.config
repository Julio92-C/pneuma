// Test-only: run MERIDIAN_RUN with a READ-ONLY root filesystem (plus a tmpfs /tmp), which is how
// Singularity/Apptainer exposes the image (/opt/meridian is not writable). Reproduces the HPC
// failure where the Quarto HTML report was silently not produced.
// TMPDIR points at a path that does not exist inside the container, as on SGE compute nodes
// (UCL Myriad) where the scheduler's node-local TMPDIR is not bound by Singularity: Quarto failed
// with "NotFound: No such file or directory (os error 2): tmpdir".
process {
    withName: 'MERIDIAN_RUN' {
        containerOptions = '--entrypoint "" --read-only --tmpfs /tmp --env TMPDIR=/tmpdir/job_not_bound'
    }
}
