// Real MERIDIAN does not run in docker tests: swap the image for a tiny one and ignore
// the (expected) MERIDIAN_RUN failure so the staged input of MERIDIAN can be inspected.
process {
    withName: 'MERIDIAN_RUN' {
        container     = 'quay.io/biocontainers/python:3.9--1'
        errorStrategy = 'ignore'
    }
}
