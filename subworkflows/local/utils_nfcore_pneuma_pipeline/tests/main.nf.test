nextflow_workflow {
    name "Test PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"

    test("groups runs per sample and keeps control flag") {
        when {
            params { outdir = "$outputDir" }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = false
                input[3] = []
                input[4] = "$outputDir"
                input[5] = "${projectDir}/assets/samplesheet_test.csv"
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            def items = workflow.out.samplesheet
            assert items.size() == 3
            def eb = items.find { it[0].id == 'EBF0-0001' }
            assert eb[0].run_ids == ['RUN1', 'RUN2']
            assert eb[1].size() == 2
            assert eb[0].single_end == true
            def cn = items.find { it[0].id == 'CNF0-0001' }
            assert cn[0].is_control == true
            assert eb[0].patient == 'PT01'
            assert cn[0].patient == ''
        }
    }

    test("--db_dir alone satisfies the database requirements") {
        when {
            params {
                outdir = "$outputDir"
                db_dir = "${projectDir}/tests/data/db_dir"
                kraken2_db = null
                taxdump = null
                host_index = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = false
                input[3] = []
                input[4] = "$outputDir"
                input[5] = "${projectDir}/assets/samplesheet_test.csv"
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.samplesheet.size() == 3
        }
    }

    test("analysis mode fails without kraken2_db/taxdump/host_index and no --db_dir") {
        when {
            params {
                outdir = "$outputDir"
                kraken2_db = null
                taxdump = null
                host_index = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = false
                input[3] = []
                input[4] = "$outputDir"
                input[5] = "${projectDir}/assets/samplesheet_test.csv"
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--kraken2_db is required')
        }
    }

    test("--build_databases needs no samplesheet and emits none") {
        when {
            params {
                build_databases = true
                db_outdir = "$outputDir/db"
                kraken_release = '20250402'
                taxdump_month = '2025-04'
                input = null
                outdir = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = false
                input[3] = []
                input[4] = "$outputDir/db"
                input[5] = null
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.samplesheet.size() == 0
        }
    }

    test("--build_databases without a release fails with a clear message") {
        when {
            params {
                build_databases = true
                db_outdir = "$outputDir/db"
                kraken_release = null
                taxdump_month = '2025-04'
                input = null
            }
            workflow {
                """
                input[0] = false
                input[1] = false
                input[2] = false
                input[3] = []
                input[4] = "$outputDir/db"
                input[5] = null
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--kraken_release YYYYMMDD is required')
        }
    }
}
