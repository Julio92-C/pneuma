nextflow_function {
    name "Test resolveDatabases (--db_dir resolution)"
    script "../main.nf"
    function "resolveDatabases"

    test("fills every database parameter from --db_dir") {
        when {
            function {
                """
                input[0] = [ db_dir: "${projectDir}/tests/data/db_dir", abricate_dbs: 'card,vfdb,plasmidfinder', pathogens: true,
                             medaka_model: 'r1041_e82_400bps_bacterial_methylation' ]   // panel_references unset: bundled default
                """
            }
        }
        then {
            assert function.success
            def r = function.result
            def root = "${projectDir}/tests/data/db_dir"
            assert r.checkm2_db == "$root/checkm2/checkm2_db_v3.dmnd"
            assert r.bakta_db == "$root/bakta/db-light"
            assert r.amrfinderplus_db == "$root/amrfinderplus/amrfinderdb.tar.gz"
            assert r.mobsuite_db == "$root/mobsuite"
            assert r.medaka_model_path == "$root/medaka/r1041_e82_400bps_bacterial_methylation_model_pt.tar.gz"
            assert r.panel_references_dir == "$root/panel_references"
            assert r.kraken2_db == "$root/kraken2_pluspf_20250402"
            assert r.taxdump == "$root/taxdump_2025-04"
            assert r.host_index == "$root/hostile/human-t2t-hla.mmi"
            assert r.abricate_db == "$root/abricate"
            assert r.database_manifest == "$root/database_manifest.tsv"
        }
    }

    test("explicit parameters override --db_dir") {
        when {
            function {
                """
                input[0] = [ db_dir: "${projectDir}/tests/data/db_dir", abricate_dbs: 'card,vfdb,plasmidfinder', pathogens: true,
                             kraken2_db: '/my/existing/kraken2', host_index: '/my/own_host.fasta',
                             checkm2_db: '/my/checkm2.dmnd',
                             medaka_model: 'r1041_e82_400bps_bacterial_methylation',
                             panel_references: "${projectDir}/assets/panel_references.tsv" ]
                """
            }
        }
        then {
            assert function.success
            def r = function.result
            assert r.kraken2_db == '/my/existing/kraken2'
            assert r.host_index == '/my/own_host.fasta'
            assert r.checkm2_db == '/my/checkm2.dmnd'
            assert r.bakta_db == "${projectDir}/tests/data/db_dir/bakta/db-light"
            assert r.taxdump == "${projectDir}/tests/data/db_dir/taxdump_2025-04"
        }
    }

    test("no --db_dir: explicit parameters are passed through, abricate_db and manifest stay unset") {
        when {
            function {
                """
                input[0] = [ kraken2_db: '/k', taxdump: '/t', host_index: '/h.fa', abricate_dbs: 'card', pathogens: false ]
                """
            }
        }
        then {
            assert function.success
            assert function.result.kraken2_db == '/k'
            assert function.result.abricate_db == null
            assert function.result.database_manifest == null
        }
    }

    test("kraken2_db and taxdump are required when not resolvable") {
        when {
            function {
                """
                input[0] = [ host_index: '/h.fa', abricate_dbs: 'card', pathogens: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.join('\n').contains('--kraken2_db is required')
            assert function.stdout.join('\n').contains('--taxdump is required')
        }
    }

    test("an incomplete --db_dir gives a clear error naming the missing files") {
        when {
            function {
                """
                def d = new File("$outputDir/broken_db")
                new File(d, 'kraken2_pluspf_20250402').mkdirs()
                new File(d, 'kraken2_pluspf_20250402/hash.k2d').text = 'x'
                new File(d, 'taxdump_2025-04').mkdirs()
                new File(d, 'taxdump_2025-04/nodes.dmp').text = 'x'
                input[0] = [ db_dir: d.toString(), abricate_dbs: 'card,vfdb,plasmidfinder', pathogens: false ]
                """
            }
        }
        then {
            assert function.failed
            def err = function.stdout.join('\n')
            assert err.contains('opts.k2d, taxo.k2d')
            assert err.contains('names.dmp')
            assert err.contains('--host_index')
        }
    }

    test("--genomic_context resolves genomad_db from --db_dir") {
        when {
            function {
                """
                input[0] = [ db_dir: "${projectDir}/tests/data/db_dir", abricate_dbs: 'card,vfdb,plasmidfinder', genomic_context: true,
                             pathogens: false ]
                """
            }
        }
        then {
            assert function.success
            assert function.result.genomad_db == "${projectDir}/tests/data/db_dir/genomad_db"
        }
    }

    test("--genomic_context without a geNomad database fails with the way out") {
        when {
            function {
                """
                input[0] = [ kraken2_db: '/k', taxdump: '/t', host_index: '/h.fasta', abricate_dbs: 'card', genomic_context: true,
                             pathogens: false ]
                """
            }
        }
        then {
            assert function.failed
            assert function.stdout.join('\n').contains('--genomic_context false')
        }
    }

    test("the mobilome resolves MOB-suite and Medaka from --db_dir without --pathogens") {
        when {
            function {
                """
                input[0] = [ db_dir: "${projectDir}/tests/data/db_dir", abricate_dbs: 'card,vfdb,plasmidfinder', pathogens: false,
                             genomic_context: true, context_local_assembly: true, mobilome: true, polish_plasmids: true,
                             medaka_model: 'r1041_e82_400bps_bacterial_methylation' ]
                """
            }
        }
        then {
            assert function.success
            def root = "${projectDir}/tests/data/db_dir"
            assert function.result.mobsuite_db == "$root/mobsuite"
            assert function.result.medaka_model_path == "$root/medaka/r1041_e82_400bps_bacterial_methylation_model_pt.tar.gz"
        }
    }

    test("the mobilome without MOB-suite / Medaka fails with the ways out") {
        when {
            function {
                """
                input[0] = [ kraken2_db: '/k', taxdump: '/t', host_index: '/h.fasta', genomad_db: '/g', abricate_dbs: 'card',
                             pathogens: false, genomic_context: true, context_local_assembly: true, mobilome: true,
                             polish_plasmids: true ]
                """
            }
        }
        then {
            assert function.failed
            def err = function.stdout.join('\n')
            assert err.contains('--mobsuite_db is required for the mobilome branch')
            assert err.contains('--mobilome false')
            assert err.contains('--polish_plasmids false')
        }
    }

    test("--polish_plasmids false drops the Medaka requirement") {
        when {
            function {
                """
                input[0] = [ kraken2_db: '/k', taxdump: '/t', host_index: '/h.fasta', genomad_db: '/g', mobsuite_db: '/m',
                             abricate_dbs: 'card', pathogens: false, genomic_context: true, context_local_assembly: true,
                             mobilome: true, polish_plasmids: false ]
                """
            }
        }
        then {
            assert function.success
        }
    }

    test("--pathogens with the mobilome: a shared missing database is reported once, as a pathogen database") {
        when {
            function {
                """
                input[0] = [ kraken2_db: '/k', taxdump: '/t', host_index: '/h.fasta', genomad_db: '/g', abricate_dbs: 'card',
                             pathogens: true, run_mobsuite: false, checkm2_db: '/c.dmnd', bakta_db: '/b', amrfinderplus_db: '/a.tar.gz',
                             genomic_context: true, context_local_assembly: true, mobilome: true, polish_plasmids: true ]
                """
            }
        }
        then {
            assert function.failed
            def err = function.stdout.join('\n')
            assert err.contains('--medaka_model_path is required for pathogen reconstruction')
            assert err.count('--medaka_model_path is required') == 1
            assert err.contains('--mobsuite_db is required for the mobilome branch')
        }
    }
}
