nextflow_workflow {
    name "Test CONTEXT_ASSEMBLY"
    script "../main.nf"
    workflow "CONTEXT_ASSEMBLY"
    options "-stub"

    test("stub run gives one hit_context table per context database") {
        when {
            params { context_databases = 'card,plasmidfinder'; genomad_splits = 8; context_min_flank = 1000; context_mge_window = 10000;
                     context_plasmid_min = 0.7; context_chrom_min = 0.7; context_recruit_min_aln = 1000
                     flye_mode = '--nano-hq'; abricate_minid = 80; abricate_mincov = 80 }
            workflow {
                """
                input[0] = channel.of([ [id:'S1'], file("${projectDir}/tests/data/context/S1.fastq", checkIfExists: true) ])
                input[1] = channel.of([ [id:'S1'], file("${projectDir}/tests/data/context/reads.fa", checkIfExists: true) ])
                input[2] = channel.of([ 'reads', 'card', file("${projectDir}/tests/data/context/assembly/loci_reads_card.tsv", checkIfExists: true) ],
                                      [ 'reads', 'plasmidfinder', file("${projectDir}/tests/data/context/assembly/loci_reads_card.tsv", checkIfExists: true) ])
                input[3] = null
                input[4] = "${projectDir}/tests/data/db_dir/genomad_db"
                input[5] = "${projectDir}/tests/data/db_dir/mobsuite"
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.hit_context.collect { it[0] }.sort() == ['card', 'plasmidfinder']
            assert workflow.out.contig_loci.size() == 2
        }
    }
}
