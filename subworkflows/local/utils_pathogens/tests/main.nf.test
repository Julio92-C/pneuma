nextflow_function {
    name "Test utils_pathogens functions"
    script "../main.nf"

    test("unitMeta builds sample and patient ids") {
        function "unitMeta"
        when {
            function {
                """
                input[0] = [species: 'Haemophilus influenzae', slug: 'Haemophilus_influenzae', taxid: '727',
                            reference_accession: 'GCF_020736045.1', confusable_accessions: 'GCF_900477945.1;GCF_016127215.1',
                            ani_min: '95.0', amrfinder_organism: 'Haemophilus_influenzae']
                input[1] = 'patient'
                input[2] = ''
                input[3] = 'PD1'
                input[4] = ['PD1-S1', 'PD1-S2']
                input[5] = false
                """
            }
        }
        then {
            assert function.success
            assert function.result.id == 'patient-PD1.Haemophilus_influenzae'
            assert function.result.confusable_accessions == ['GCF_900477945.1', 'GCF_016127215.1']
            assert function.result.samples == ['PD1-S1', 'PD1-S2']
            assert function.result.single_end == true
        }
    }

    test("poolingDecision pools only when no sample passed and >= 2 samples contribute") {
        function "poolingDecision"
        when {
            function {
                """
                input[0] = 'PD1'
                input[1] = [[sample: 'PD1-S2', gate_pass: false, is_control: false],
                            [sample: 'PD1-S1', gate_pass: false, is_control: false]]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['PD1-S1', 'PD1-S2']
        }
    }

    test("poolingDecision: a passing sample means no pooling") {
        function "poolingDecision"
        when {
            function {
                """
                input[0] = 'PA1'
                input[1] = [[sample: 'A', gate_pass: true, is_control: false], [sample: 'B', gate_pass: false, is_control: false]]
                """
            }
        }
        then {
            assert function.success
            assert function.result == []
        }
    }

    test("poolingDecision: one sample, or no patient, means no pooling") {
        function "poolingDecision"
        when {
            function {
                """
                input[0] = ''
                input[1] = [[sample: 'A', gate_pass: false, is_control: false], [sample: 'B', gate_pass: false, is_control: false]]
                """
            }
        }
        then {
            assert function.success
            assert function.result == []
        }
    }

    test("referenceFiles lists the reference then the confusables, de-duplicated") {
        function "referenceFiles"
        when {
            function {
                """
                input[0] = [reference: 'GCF_1.1', confusable_accessions: ['GCF_2.1', 'GCF_1.1']]
                input[1] = file('/data/ref')
                """
            }
        }
        then {
            assert function.success
            assert function.result.collect { f -> f.toString().tokenize('/')[-1] } == ['GCF_1.1.fna.gz', 'GCF_2.1.fna.gz']
        }
    }
}
